  "placement": {
    "tree": "On terrain, scattered with varied rotation and scale; keep paths clear.",
    "flower": "On terrain in clusters near paths, beds and walls.",
    "crop": "In rows inside a fenced field.",
    "interior": "Inside its building, at the building's position and rotation; with \"collision\": \"mesh\" its counters and stalls block the player.",
    "ground-flora": "Scattered on terrain to break up flat ground; hide wall and rock bases.",
    "rock": "Half sunk into the terrain so no floating edge shows.",
    "furniture": "Inside a building, on the floor, against walls; leave walking lanes.",
    "building-part": "Snap to the pack's own grid with other pieces of the same pack; close every visible gap.",
    "lamp": "At doors, path junctions and bridge ends; lit at night.",
    "signage": "At eye height near junctions and entrances (wayfinding).",
    "fence": "Along field, garden and path edges; join the ends.",
    "road": "Flush with the terrain; connect every entrance.",
    "prop": "Near the place it belongs to (market, workshop, kitchen); group in small clusters."
  },
