      "roof_shingle":  {"layer": "shingle",    "tint": "#7a5a32", "use": "Herbalists' roofs"},
      "roof_thatch":   {"layer": "thatch",     "tint": "#cfae62", "use": "cottages, barns"},
      "cobble":        {"layer": "cobble",     "tint": "#938e83", "use": "streets"},
      "iron":          {"layer": "iron",       "tint": "#4d5157", "use": "straps, hinges, lamps"},
      "trim":          {"layer": "trim",       "use": "trim sheet: carved and moulded strips with no extra geometry"}
    },
    "trim_sheet": {
      "strips": ["cornice", "frame", "moulding", "carved", "dentil", "rope", "beam", "strap"],
      "looks": {"cornice": "#cfc4ae", "frame": "#d6ccb8", "moulding": "#cfc4ae", "carved": "#d8cdb5", "dentil": "#cfc4ae", "rope": "#cbbfa6", "beam": "#5c3b22", "strap": "#4d5157"},
      "mapping": "strip runs along the face's long axis, its profile across the short one; each strip is 1/8 of the texture height",
      "source": "scripts/world/masterplan/mp_materials.gd TRIM_PATTERN, TRIM"
    },
    "paint_rules": [
      "Paint the age in: darker, damper bases at the ground and under eaves, moss on north and stone faces, lighter wear along edges.",
      "One weathered base colour per material, small shifts per object.",
      "No black and no pink (missing-texture) surfaces."
    ],
    "source": "scripts/world/masterplan/mp_materials.gd header (13 layers incl. the trim sheet, 256 px/m, warm balance); kit/tools/paint_materials.py LAYERS"
  },
  "material_recipes": {
    "stone": {
      "city_shader": "shaders/mp_statue_stone.gdshader, shaders/mp_painted.gdshaderinc",
      "gltf": {"baseColorTexture": "ashlar or stone layer", "baseColorFactor": "#dbd1bd", "metallic": 0.0, "roughness": 0.9},
      "notes": "Painted AO and light baked into the texture or vertex colours (kit/blender/bake_unlit.py, KHR_materials_unlit) give the city's soft wrap light; never metallic, never glossy (no plastic or chrome)."
    },
    "water": {
      "city_shader": "shaders/pond_water.gdshader",
      "gltf": {"baseColorFactor": "#3d8c8f", "deep_colour": "#14455c", "alphaMode": "BLEND", "alpha": [0.32, 0.84], "metallic": 0.0, "roughness": 0.08},
      "notes": "A package cannot animate waves or foam; paint a foam band into the shore texture and use a vertex-alpha gradient from shallow (0.32) to deep (0.84). Keep the water surface 2 cm or more off any bed geometry."
    },
    "night_glow": {
      "city_shader": "shaders/mp_painted.gdshaderinc (glow kinds 1-7), mp_look.gd WINDOW_GLOW",
      "gltf": {"emissiveFactor": "region window_glow", "emissiveStrength": [1.0, 1.7], "baseColorFactor": "#2f4660"},
      "notes": "The city raises window glow at night (0.05 -> 1.7); a package's emissive is constant. House glass: keep it about 0.2 (style-gen houses, an internal task): at 0.5 or more the panes read as flat amber panels by day (harbour a5); lamp and lantern glass, seen mostly at dusk, can go to 1.0-1.7. Or ship a night variant of the world. Fake most lamps with emissive glass: only the nearest 6 lamps get a real light."
    }
  },
