    "repo": "the iamar browser source (not public)",
    "commit": "2116b91e",
    "guide": "docs/WORLD_ART_GUIDE.md (the iamar browser source (not public))",
    "note": "Every value names the symbol it was read from (file + constant), checked at the commit above."
  },
