@echo off
rem iamar-world download-login (Windows twin of kit/download_login.sh): get a download pass for the
rem invitation-only iamar browser without the download password (device code). The person approves
rem once in their own web browser; the agent never sees the password.
rem   download_login.cmd          start, print the HUMAN STEP, wait for the approval (up to 10 min)
rem   download_login.cmd start    start and print the HUMAN STEP, then exit
rem   download_login.cmd wait     wait for the approval of the code that start made
rem The pass goes to IAMAR_DOWNLOAD_TOKEN_FILE (default %APPDATA%\iamar\download_token); it lasts
rem 30 days, kit\runtime_fetch.cmd sends it, and it is never printed. Uses Windows PowerShell only.
setlocal EnableExtensions DisableDelayedExpansion
set "DL_MODE=%~1"
if not defined DL_MODE set "DL_MODE=both"
if /i not "%DL_MODE%"=="both" if /i not "%DL_MODE%"=="start" if /i not "%DL_MODE%"=="wait" (
  echo usage: iamar-world download-login [start^|wait] 1>&2
  exit /b 2
)
"%SystemRoot%\System32\WindowsPowerShell\v1.0\powershell.exe" -NoLogo -NoProfile -NonInteractive -Command "$ErrorActionPreference = 'Stop'; $site = $env:IAMAR_SITE; if (-not $site) { $site = 'https://iamar.ai' }; $site = $site.TrimEnd('/'); if ($site -notmatch '^https://' -and $site -notmatch '^http://(127[.]0[.]0[.]1|localhost):') { [Console]::Error.WriteLine('download-login: IAMAR_SITE must be https://'); exit 2 }; [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12; $file = $env:IAMAR_DOWNLOAD_TOKEN_FILE; if (-not $file) { $file = Join-Path $env:APPDATA 'iamar\download_token' }; $pending = $file + '.pending'; New-Item -ItemType Directory -Force -Path (Split-Path -Parent $file) | Out-Null; if ($env:DL_MODE -ne 'wait') { try { $r = Invoke-RestMethod -Method Post -Uri ($site + '/download/agent/start') -Body '' -UseBasicParsing } catch { [Console]::Error.WriteLine('download-login: ' + $site + ' did not start a code (' + $_.Exception.Message + '); set IAMAR_KIT_CODE to the download password instead'); exit 3 }; if ([string]$r.code -cnotmatch '^[A-Z0-9]{4}-[A-Z0-9]{4}$' -or [string]$r.device_secret -notmatch '^[A-Za-z0-9_-]{20,200}$' -or ([string]$r.verify_url -ne ($site + '/download/agent?code=' + $r.code) -and [string]$r.verify_url -ne ('https://iamar.ai/download/agent?code=' + $r.code))) { [Console]::Error.WriteLine('download-login: unexpected reply from ' + $site); exit 3 }; $ttl = [int]$r.expires_in; if ($ttl -le 0) { $ttl = 600 }; Set-Content -LiteralPath $pending -Value ($r.code + ' ' + $r.device_secret + ' ' + ([DateTimeOffset]::UtcNow.ToUnixTimeSeconds() + $ttl)) -Encoding ASCII; Write-Output ('HUMAN STEP: open ' + $r.verify_url + ' in your web browser, check that it shows the code ' + $r.code + ','); Write-Output ('  enter the iamar download password if it asks, and press Allow. The code works for ' + [int]($ttl / 60) + ' minutes.'); if ($env:DL_MODE -eq 'start') { Write-Output 'Then run: iamar-world download-login wait'; exit 0 } }; if (-not (Test-Path -LiteralPath $pending)) { [Console]::Error.WriteLine('download-login: no code is waiting; run iamar-world download-login start first'); exit 2 }; $code, $secret, $deadline = (Get-Content -LiteralPath $pending -TotalCount 1) -split ' '; if ($code -cnotmatch '^[A-Z0-9]{4}-[A-Z0-9]{4}$' -or $secret -notmatch '^[A-Za-z0-9_-]{20,200}$' -or $deadline -notmatch '^[0-9]+$') { Remove-Item -LiteralPath $pending -Force; [Console]::Error.WriteLine('download-login: the waiting code is damaged; run iamar-world download-login start again'); exit 2 }; [Console]::Error.WriteLine('waiting for the approval of ' + $code + ' ...'); $body = (@{ code = $code; device_secret = $secret } | ConvertTo-Json -Compress); while ([DateTimeOffset]::UtcNow.ToUnixTimeSeconds() -le ([long]$deadline + 5)) { try { $p = Invoke-RestMethod -Method Post -Uri ($site + '/download/agent/poll') -ContentType 'application/json' -Body $body -UseBasicParsing } catch { $st = 0; if ($_.Exception.Response) { $st = [int]$_.Exception.Response.StatusCode }; if ($st -eq 410) { Remove-Item -LiteralPath $pending -Force; [Console]::Error.WriteLine('download-login: code ' + $code + ' expired or was used; run iamar-world download-login again'); exit 4 }; Start-Sleep -Seconds 3; continue }; if ($p.status -eq 'approved') { $t = [string]$p.token; if ($t -notmatch '^iamar-dl1[.][0-9]+[.][0-9a-f]{64}$') { [Console]::Error.WriteLine('download-login: unexpected token format from ' + $site); exit 3 }; $tmp = $file + '.new'; Set-Content -LiteralPath $tmp -Value $t -Encoding ASCII; Move-Item -LiteralPath $tmp -Destination $file -Force; Remove-Item -LiteralPath $pending -Force; Write-Output ('DOWNLOAD PASS saved in ' + $file + ' (30 days). kit\runtime_fetch.cmd browser now downloads the iamar browser.'); exit 0 }; Start-Sleep -Seconds 3 }; Remove-Item -LiteralPath $pending -Force; [Console]::Error.WriteLine('download-login: nobody approved ' + $code + ' in time; run iamar-world download-login again'); exit 4"
exit /b %ERRORLEVEL%
